// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  STUDENT
  ADMIN
}

model User{
  id Int      @id @default(autoincrement())
  name String
  email String @unique
  role UserRole @default(STUDENT)
  password String
  items Item[]
  claims   Claim[]
  notifications  Notification[]
  created_at  DateTime @default(now())
}

enum ItemType {
  LOST
  FOUND
}

enum ItemStatus {
  OPEN
  CLAIMED
  RESOLVED
}

model Item {
  id              Int        @id @default(autoincrement())
  type            ItemType
  title           String
  description     String
  category        String
  imageUrl        String
  location        String
  timestamp       DateTime   @default(now())
  status          ItemStatus @default(OPEN)
  uploadedById     Int
  uploadedBy      User @relation(fields: [uploadedById], references: [id])
  // embeddingVector Float[]?
  lostMatches  Match[]    @relation("LostMatches")
  foundMatches Match[]    @relation("FoundMatches")
  claims       Claim[]
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
}


model Match {
  id              Int      @id @default(autoincrement())

  lostItemId      Int
  foundItemId     Int

  similarityScore Float

  status          MatchStatus @default(PENDING)
  claim           Claim?
  lostItem        Item @relation("LostMatches", fields: [lostItemId], references: [id])
  foundItem       Item @relation("FoundMatches", fields: [foundItemId], references: [id])

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

enum MatchStatus {
  PENDING
  CONFIRMED
  MATCHED
  REJECTED
}

enum AdminStatus {
  PENDING
  APPROVED
  REJECTED
}

model Claim {
  id                Int         @id @default(autoincrement())

  itemId            Int
  item              Item        @relation(fields: [itemId], references: [id])

  claimerId         Int
  claimer           User        @relation(fields: [claimerId], references: [id])

  verificationScore Float?

  adminStatus       AdminStatus @default(PENDING)

   matchId Int @unique
  match Match @relation(fields: [matchId], references: [id])

  pickupLocation    String?
  pickupTime        DateTime?

  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
}

model Notification {
  id        Int      @id @default(autoincrement())

  userId    Int
  user      User     @relation(fields: [userId], references: [id])

  title     String?
  message   String?

  isRead    Boolean  @default(false)

  createdAt DateTime @default(now())
}